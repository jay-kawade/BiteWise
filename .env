# ==============================================================================
# Environment configuration template.
#
# Copy this file to ".env" and fill in real values if you want the optional
# features (LLM-powered assistant). NEVER commit your real ".env" file.
#
#   cp .env.example .env
# ==============================================================================

# When true, the app uses only local resources: local SQLite database, the
# bundled sample food dataset, the locally trained ML model, and a rule-based
# (non-LLM) assistant fallback. The application is fully demonstrable with
# DEMO_MODE=true and no API keys at all.
DEMO_MODE=true

# Path to the SQLite database file (created automatically on first run).
DATABASE_PATH=data/processed/nutrition_app.db

# --- Optional: Large Language Model for the conversational AI assistant ---
# If left empty, the AI Nutrition Assistant automatically falls back to a
# deterministic, rule-based intent router (see src/agent/orchestrator.py).
# Get a key from https://console.anthropic.com/ if you want to enable this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Optional: OCR configuration ---
# Path to the Tesseract OCR executable if it is not on your system PATH.
# Leave empty to use the default system PATH lookup.
TESSERACT_CMD=

# --- Optional: External nutrition data API ---
# This project ships with a local sample food database so it works without
# any external API. If you later integrate a real provider (e.g. USDA
# FoodData Central: https://fdc.nal.usda.gov/api-guide.html), put its key
# here and wire it up behind src/database/repositories.py.
NUTRITION_API_KEY=
